{
  "Agent": {
    "ServerUrl": "https://filemon.example.com",
    "EnrollmentToken": "",
    "AllowInsecureHttp": false,
    "DataDir": "C:\\ProgramData\\FileMonitoringAgent",
    "MinConfidence": 0.6,
    "Applications": [
      { "name": "Telegram", "processNames": ["Telegram.exe"], "enabled": true },
      { "name": "WhatsApp", "processNames": ["WhatsApp.exe", "WhatsApp.Root.exe"], "enabled": true },
      { "name": "imo", "processNames": ["imo.exe"], "enabled": true },
      { "name": "Microsoft Teams", "processNames": ["ms-teams.exe", "Teams.exe"], "enabled": true },
      { "name": "Discord", "processNames": ["Discord.exe"], "enabled": true }
    ]
  },
  "Logging": { "LogLevel": { "Default": "Information" } }
}
